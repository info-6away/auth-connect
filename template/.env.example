# ── 6away Auth Connect — the only five vars an app needs ──────────────────────
#
# Values must be stored BYTE-FOR-BYTE. A stray space, trailing newline or a
# byte-order mark (BOM) silently corrupts a URL or a secret, and the failure
# surfaces much later as "invalid redirect_uri" or a session that never
# validates. On Windows PowerShell, piping a value into `vercel env add` can
# prepend a BOM — paste secrets into the Vercel dashboard instead. See the
# "Troubleshooting" section of the README.
#
# After changing any of these on a deployment, REDEPLOY. Env vars are read at
# build/boot; editing them does not update a running deployment.

# OAuth client credentials (issued per-app in auth.6away.ai).
# AUTH_CLIENT_ID is not sensitive; AUTH_CLIENT_SECRET is. SERVER-ONLY.
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# 32-byte random key signing this app's own session cookie. SECRET. SERVER-ONLY.
# The IdP never sees it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Issuer origin (no trailing slash). PUBLIC — same in local and production.
NEXT_PUBLIC_AUTH_URL=https://auth.6away.ai

# This app's own origin (no trailing slash). PUBLIC.
# ─ DIFFERS BETWEEN ENVIRONMENTS ─
#   local:      http://localhost:3000
#   production: https://your-app.example  (your real domain)
# Used to build the post-logout redirect, so a wrong value sends signed-out
# users to the wrong host.
NEXT_PUBLIC_APP_URL=http://localhost:3000
