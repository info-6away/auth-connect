# ── 6away Auth Connect — the only five vars an app needs ──────────────────────

# OAuth client credentials (issued per-app in auth.6away.ai). SECRET.
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# 32-byte random key for signing the session cookie. SECRET.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Issuer origin (no trailing slash).
NEXT_PUBLIC_AUTH_URL=https://auth.6away.ai

# This app's own origin (no trailing slash). Used for post-logout redirect.
# e.g. https://app.myapp.guru  — or http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
