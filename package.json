{
  "name": "@6away/auth-connect",
  "version": "1.0.2",
  "description": "Plug-and-play 6away Auth (OIDC) relying-party layer for Next.js App Router apps.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "files": [
    "dist",
    "template",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsc -p examples/throwaway/tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
